# Secrets
.env
.modal.toml

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# Data / model artifacts
*.pkl
*.pth
*.pt
*.csv

# OS
.DS_Store

# Results
# Track lightweight top-level JSON summaries for reproducibility, but keep large
# embedding caches and generated media local-only.
results/*
!results/*.json
results/embeddings_all.json
results/video_pdbs/
results/video_pngs/
results/videos/
results/*.gif
results/*.mp4

# Data (downloaded)
data/

# Generated PDFs (compiled from tex)
tex/main.pdf
tex/*.aux
tex/*.log
tex/*.bbl
tex/*.blg

# Alternative figure themes from src/restyle_figures.py — kept locally only.
# Bold/Okabe-Ito is the published variant and lives in tex/figures/.
tex/figures_calm/
tex/figures_minimal/
tex/figures_bold/
tex/figures_original/
tex/figures_compare.html

# uv lock (large)
uv.lock

# Working notes (private)
notes/

# Old notebooks (private)
old_codes/

# Editor
.cursor/
